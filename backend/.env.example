# ---- Runtime ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Set true behind a TLS-terminating proxy (Render, Fly, nginx) so req.ip / protocol are correct.
TRUST_PROXY=false
# Run SQL migrations automatically at startup (set false to run `npm run migrate:prod` separately).
MIGRATE_ON_START=true

# ---- Database (docker compose maps PostgreSQL to 5433) ----
DATABASE_URL=postgres://gallery:gallery@localhost:5433/gallery
DATABASE_SSL=false
# Used only by `npm test` (created by docker/init-db.sql).
TEST_DATABASE_URL=postgres://gallery:gallery@localhost:5433/gallery_test

# ---- Public URLs ----
# Base URL clients use for this API (also used to build wss:// ticket URLs).
PUBLIC_API_URL=http://localhost:8080
# Website (editor) base URL, used for links shown to users.
PUBLIC_WEB_URL=http://localhost:5173
# HTTPS base handled by the iOS app as a Universal Link; falls back to the web landing page.
DEEP_LINK_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# ---- Object storage (S3-compatible; SeaweedFS in docker compose) ----
S3_ENDPOINT=http://localhost:8333
# Endpoint embedded in signed URLs; must be reachable by browsers/phones.
# For a phone on your LAN use http://<your-computer-LAN-IP>:8333.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gallery-assets
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey123
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
SIGNED_URL_TTL_SEC=900

# ---- Auth ----
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
WS_TICKET_TTL_SEC=60
VIEWER_SESSION_TTL_SEC=43200
# Email invitations expire after this many hours; phone pairing codes after PAIRING_TTL_SEC.
INVITATION_TTL_HOURS=168
PAIRING_TTL_SEC=600

# ---- Assistant (Gemini) ----
# Server-side only; never sent to clients. Leave empty to run with the assistant disabled.
GEMINI_API_KEY=
# gemini | disabled (default: gemini when a key is set). "fake" is a deterministic
# test double for automated tests/local UI work and is refused when NODE_ENV=production.
ASSISTANT_PROVIDER=
# Verify availability for your key with `npm run smoke:gemini` before a demo.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_TTS_TIMEOUT_MS=30000
ASSISTANT_MAX_RETRIES=2
ASSISTANT_CONCURRENCY=4
ASSISTANT_COMMANDS_PER_MINUTE=12
ASSISTANT_MAX_INPUT_CHARS=1000
ASSISTANT_MAX_HISTORY_TURNS=8
ASSISTANT_MAX_CONTEXT_NODES=200
ASSISTANT_MAX_AUDIO_BYTES=4194304
ASSISTANT_MAX_AUDIO_SECONDS=30
ASSISTANT_MAX_SPEECH_CHARS=600

# ---- Donations (Solana, optional) ----
# Custodial: the server creates and holds one wallet per gallery. Read docs/donations.md first.
SOLANA_ENABLED=false
# devnet (default, test money) | testnet | mainnet-beta (real money; also needs SOLANA_ALLOW_MAINNET=true)
SOLANA_CLUSTER=devnet
SOLANA_ALLOW_MAINNET=false
# Leave empty for the public endpoint of the cluster; use a dedicated RPC provider in production.
SOLANA_RPC_URL=
# 32-byte key that encrypts every gallery wallet's private key. Generate with
# `npm run solana:keygen`. Back it up separately: losing it makes the funds unrecoverable.
SOLANA_WALLET_ENCRYPTION_KEY=
SOLANA_MIN_DONATION_LAMPORTS=10000
SOLANA_INTENT_TTL_SEC=1800
SOLANA_POLL_INTERVAL_MS=15000
SOLANA_WITHDRAWALS_PER_HOUR=5

# ---- Demo limits (starting assumptions, not measured capacity) ----
LIMIT_AUTH_ATTEMPTS_PER_MINUTE=10
LIMIT_EDITORS_PER_GALLERY=5
LIMIT_EDITOR_CONNECTIONS_PER_GALLERY=10
LIMIT_VIEWER_CONNECTIONS_PER_GALLERY=10
LIMIT_MAX_NODES=2000
LIMIT_MAX_OPS_PER_BATCH=200
LIMIT_MAX_SCENE_BYTES=2000000
LIMIT_MAX_UPLOAD_BYTES=20971520
LIMIT_MAX_IMAGE_PIXELS=40000000
LIMIT_EVENT_REPLAY_WINDOW=500
LIMIT_WS_MAX_BUFFERED_BYTES=4194304
LIMIT_WS_MAX_MESSAGE_BYTES=262144
WS_HEARTBEAT_MS=25000
