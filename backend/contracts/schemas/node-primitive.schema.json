{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "node-primitive.schema.json",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "parentId",
    "transform",
    "visible",
    "locked",
    "props",
    "ext"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Stable node ID, unique within the scene."
    },
    "type": {
      "type": "string",
      "const": "primitive"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "Stable node ID, unique within the scene."
        },
        {
          "type": "null"
        }
      ]
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            }
          ],
          "minItems": 3,
          "description": "Meters [x, y, z]."
        },
        "rotation": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "description": "Unit quaternion [x, y, z, w]."
        },
        "scale": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            }
          ],
          "minItems": 3,
          "description": "Positive per-axis scale."
        }
      },
      "additionalProperties": false,
      "description": "Local transform relative to the parent node."
    },
    "visible": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean",
      "description": "Editor hint: locked nodes are not selectable in the website editor."
    },
    "props": {
      "type": "object",
      "required": [
        "shape",
        "size",
        "material"
      ],
      "properties": {
        "shape": {
          "anyOf": [
            {
              "type": "string",
              "const": "box"
            },
            {
              "type": "string",
              "const": "sphere"
            },
            {
              "type": "string",
              "const": "cylinder"
            },
            {
              "type": "string",
              "const": "cone"
            },
            {
              "type": "string",
              "const": "plane"
            },
            {
              "type": "string",
              "const": "torus"
            }
          ]
        },
        "size": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            }
          ],
          "minItems": 3,
          "description": "Bounding size in meters [x, y, z] before scale; centered on the origin."
        },
        "material": {
          "type": "object",
          "required": [
            "color",
            "roughness",
            "metalness",
            "opacity",
            "emissiveColor",
            "emissiveIntensity",
            "textureAssetId",
            "textureRepeat"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "sRGB hex color \"#rrggbb\"."
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metalness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emissiveColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "sRGB hex color \"#rrggbb\"."
            },
            "emissiveIntensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "textureAssetId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "description": "ID of an uploaded asset in this gallery."
                },
                {
                  "type": "null"
                }
              ]
            },
            "textureRepeat": {
              "type": "array",
              "additionalItems": false,
              "items": [
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 100
                },
                {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 100
                }
              ],
              "minItems": 2,
              "description": "Texture tiling [u, v]."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ext": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {}
      },
      "description": "Client extension metadata. Opaque to the server, at most 4096 bytes as JSON."
    }
  },
  "additionalProperties": false,
  "title": "primitive node"
}