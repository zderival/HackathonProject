{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "node-light.schema.json",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "parentId",
    "transform",
    "visible",
    "locked",
    "props",
    "ext"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Stable node ID, unique within the scene."
    },
    "type": {
      "type": "string",
      "const": "light"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "Stable node ID, unique within the scene."
        },
        {
          "type": "null"
        }
      ]
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            }
          ],
          "minItems": 3,
          "description": "Meters [x, y, z]."
        },
        "rotation": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "description": "Unit quaternion [x, y, z, w]."
        },
        "scale": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            }
          ],
          "minItems": 3,
          "description": "Positive per-axis scale."
        }
      },
      "additionalProperties": false,
      "description": "Local transform relative to the parent node."
    },
    "visible": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean",
      "description": "Editor hint: locked nodes are not selectable in the website editor."
    },
    "props": {
      "type": "object",
      "required": [
        "lightType",
        "color",
        "intensity",
        "range",
        "angle",
        "penumbra",
        "castShadow"
      ],
      "properties": {
        "lightType": {
          "anyOf": [
            {
              "type": "string",
              "const": "ambient"
            },
            {
              "type": "string",
              "const": "directional"
            },
            {
              "type": "string",
              "const": "point"
            },
            {
              "type": "string",
              "const": "spot"
            }
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "sRGB hex color \"#rrggbb\"."
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Relative intensity; clients map to their light units."
        },
        "range": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Point/spot falloff distance (m); 0 = infinite."
        },
        "angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5707963267948966,
          "description": "Spot cone half-angle (radians)."
        },
        "penumbra": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "castShadow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ext": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {}
      },
      "description": "Client extension metadata. Opaque to the server, at most 4096 bytes as JSON."
    }
  },
  "additionalProperties": false,
  "title": "light node"
}