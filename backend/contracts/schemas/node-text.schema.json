{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "node-text.schema.json",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "parentId",
    "transform",
    "visible",
    "locked",
    "props",
    "ext"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Stable node ID, unique within the scene."
    },
    "type": {
      "type": "string",
      "const": "text"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "Stable node ID, unique within the scene."
        },
        {
          "type": "null"
        }
      ]
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            }
          ],
          "minItems": 3,
          "description": "Meters [x, y, z]."
        },
        "rotation": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "description": "Unit quaternion [x, y, z, w]."
        },
        "scale": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            },
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            }
          ],
          "minItems": 3,
          "description": "Positive per-axis scale."
        }
      },
      "additionalProperties": false,
      "description": "Local transform relative to the parent node."
    },
    "visible": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean",
      "description": "Editor hint: locked nodes are not selectable in the website editor."
    },
    "props": {
      "type": "object",
      "required": [
        "text",
        "fontSize",
        "color",
        "align",
        "maxWidth",
        "backgroundColor",
        "billboard"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 500
        },
        "fontSize": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 5,
          "description": "Cap height in meters."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "sRGB hex color \"#rrggbb\"."
        },
        "align": {
          "anyOf": [
            {
              "type": "string",
              "const": "left"
            },
            {
              "type": "string",
              "const": "center"
            },
            {
              "type": "string",
              "const": "right"
            }
          ]
        },
        "maxWidth": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 50,
          "description": "Wrap width in meters."
        },
        "backgroundColor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "sRGB hex color \"#rrggbb\"."
            },
            {
              "type": "null"
            }
          ]
        },
        "billboard": {
          "type": "boolean",
          "description": "If true the client keeps the label facing the camera."
        }
      },
      "additionalProperties": false
    },
    "ext": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_.-]{1,64}$": {}
      },
      "description": "Client extension metadata. Opaque to the server, at most 4096 bytes as JSON."
    }
  },
  "additionalProperties": false,
  "title": "text node"
}