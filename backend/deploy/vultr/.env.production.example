# Copy to .env.production on the server (never commit the filled-in file).
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true
MIGRATE_ON_START=true

# Vultr Managed PostgreSQL: copy the connection string from the database "Overview" tab.
DATABASE_URL=postgres://vultradmin:CHANGE_ME@vultr-prod-xxxx.vultrdb.com:16751/defaultdb
DATABASE_SSL=true

# Public URLs (HTTPS). API_DOMAIN in deploy/vultr must match PUBLIC_API_URL's host.
PUBLIC_API_URL=https://api.example.com
PUBLIC_WEB_URL=https://gallery.example.com
DEEP_LINK_BASE_URL=https://gallery.example.com
CORS_ORIGINS=https://gallery.example.com

# Vultr Object Storage (S3-compatible). Hostname from the Object Storage overview.
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_PUBLIC_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=gallery-assets-prod
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
SIGNED_URL_TTL_SEC=900

# Assistant
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Demo limits (starting assumptions, not measured capacity)
LIMIT_EDITORS_PER_GALLERY=5
LIMIT_EDITOR_CONNECTIONS_PER_GALLERY=10
LIMIT_VIEWER_CONNECTIONS_PER_GALLERY=10
