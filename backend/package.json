{
  "name": "gallery-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "migrate:prod": "node dist/src/db/migrate.js",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export:contracts": "tsx scripts/export-contracts.ts",
    "smoke:gemini": "tsx --env-file-if-exists=.env scripts/smoke-gemini.ts",
    "storage:cors": "tsx --env-file-if-exists=.env scripts/storage-cors.ts",
    "solana:keygen": "node -e \"console.log('SOLANA_WALLET_ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "demo:simulate": "tsx --env-file-if-exists=.env scripts/demo-simulate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.4",
    "@google/genai": "^2.28.0",
    "@solana/web3.js": "^1.99.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "json-schema-to-typescript": "^16.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
