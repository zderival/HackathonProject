# My World front end: copy to .env if you like (serve.mjs reads real environment variables, so
# you can also just put them in front of the command:  PORT=3000 node serve.mjs)

# Where this page is served
PORT=5173
HOST=0.0.0.0

# The backend (the HackathonProject-main/backend folder, `npm run dev` there)
BACKEND_URL=http://localhost:8080

# Phones only share motion sensors on https. Either:
#   HTTPS=1                       a self-made certificate (the phone shows a warning once; tap through it)
#   PUBLIC_URL=https://abc.trycloudflare.com    a tunnel that already has https in front of this server
HTTPS=
PUBLIC_URL=
